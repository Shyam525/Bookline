# Bookline Environment Configuration Example

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=bookline_db;Username=postgres;Password=replace-with-local-password

# Redis
Redis__ConnectionString=localhost:6379

# Authentication (JWT)
Jwt__SecretKey=replace-with-a-unique-random-secret-of-at-least-32-characters
Jwt__Issuer=Bookline
Jwt__Audience=BooklineUsers
Jwt__ExpiryMinutes=1440

# Mailpit Email (Local Development)
Email__SmtpHost=localhost
Email__SmtpPort=1026
Email__SenderEmail=no-reply@bookline.local

# Application Port
ASPNETCORE_URLS=http://localhost:5168
