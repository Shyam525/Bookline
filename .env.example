# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_DB=bookline_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
ConnectionStrings__DefaultConnection=Host=localhost;Database=bookline_db;Username=postgres;Password=postgrespassword

# Redis Configuration (Distributed Slot Holds & Coordination)
Redis__ConnectionString=localhost:6379

# JWT Authentication Settings
JwtSettings__Secret=SuperSecretKeyForBooklineApiThatIsAtLeast32BytesLong!
JwtSettings__Issuer=Bookline
JwtSettings__Audience=BooklineApp
JwtSettings__ExpiryMinutes=1440

# Maps & Geocoding (Local Mode fallback active when empty)
MAPS_PROVIDER=Local
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Payments Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Communications & Notifications (Mailpit active by default)
Smtp__Host=localhost
Smtp__Port=1026
SMS_PROVIDER=Mock
WHATSAPP_PROVIDER=Mock

# Platform Economics
PLATFORM_COMMISSION_PERCENTAGE=10.0
FEATURE_FLAGS__MAPS_ENABLED=true
FEATURE_FLAGS__GEO_DISCOVERY_ENABLED=true
FEATURE_FLAGS__PRODUCTS_ENABLED=true
FEATURE_FLAGS__REVIEWS_ENABLED=true
