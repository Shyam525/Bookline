# =====================================================================
# Bookline — Staging Environment Variables Template
# Copy to .env.staging and set production-grade secrets before deployment
# =====================================================================

# PostgreSQL Configuration
POSTGRES_DB=bookline_staging
POSTGRES_USER=bookline_staging_user
POSTGRES_PASSWORD=replace_with_strong_staging_db_password_min_32_chars

# Redis Configuration
REDIS_PASSWORD=replace_with_strong_staging_redis_password_min_32_chars

# ASP.NET Core & JWT
ASPNETCORE_ENVIRONMENT=Staging
JWT_SECRET_KEY=replace_with_cryptographically_secure_random_256bit_key_min_64_characters_long
JWT_ISSUER=https://staging.bookline.in
JWT_AUDIENCE=https://staging.bookline.in

# Public Host / Domain
PUBLIC_DOMAIN=staging.bookline.in

# Production / Staging Notifications
NOTIFICATION_PROVIDER=Console
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

SMS_ENABLED=false
SMS_PROVIDER=MSG91
SMS_AUTH_KEY=
SMS_DLT_TE_ID=
SMS_SENDER_ID=BOKLIN

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@staging.bookline.in
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=no-reply@staging.bookline.in
SMTP_FROM_NAME=Bookline Staging

